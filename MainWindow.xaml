<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办" Width="392" Height="580" MinWidth="340" MinHeight="410"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#303A36">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3C7865"/>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#66736C"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF2EE"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DFEBE3"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
    <Style x:Key="CircleCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="32" Height="34" Background="Transparent">
              <Ellipse x:Name="Circle" Width="20" Height="20" Stroke="#ABB8AF" StrokeThickness="1.5" Fill="Transparent"/>
              <Path x:Name="Tick" Data="M 10,17 L 14,21 L 22,12" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="#3C7865"/><Setter TargetName="Circle" Property="Fill" Value="#E9F2EB"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#3C7865"/><Setter TargetName="Circle" Property="Stroke" Value="#3C7865"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="StrokeThickness" Value="3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PinStyle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#68736C"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="PinSurface" CornerRadius="13" BorderBrush="#E2E7E1" BorderThickness="1" Background="White" Padding="11,6">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 4,0 L 12,0 M 6,0 L 6,6 L 3,9 L 13,9 L 10,6 L 10,0 M 8,9 L 8,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Width="16" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="固定到桌面" FontSize="11"/>
                <Ellipse x:Name="PinDot" Width="5" Height="5" Fill="#A5AEA7" Margin="7,0,0,0"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#3C7865"/><Setter TargetName="PinSurface" Property="Background" Value="#EAF2EC"/><Setter TargetName="PinSurface" Property="BorderBrush" Value="#D5E5D9"/><Setter TargetName="PinDot" Property="Fill" Value="#3C7865"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinSurface" Property="BorderBrush" Value="#87A991"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PinSurface" Property="BorderBrush" Value="#3C7865"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="TaskTemplate">
      <Border x:Name="TaskSurface" Padding="6,9" Margin="0,0,0,5" CornerRadius="10" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource CircleCheck}" IsChecked="{Binding IsCompleted, Mode=TwoWay}" ToolTip="完成 / 恢复待办" AutomationProperties.Name="{Binding CheckLabel}"/>
          <TextBlock x:Name="TaskLabel" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,6,6,6" FontSize="14" Cursor="IBeam" ToolTip="双击编辑；右键可编辑或删除">
            <TextBlock.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"/></TextBlock.InputBindings>
            <TextBlock.ContextMenu><ContextMenu><MenuItem Header="编辑任务" Command="{Binding EditCommand}"/><MenuItem Header="删除任务" Command="{Binding DeleteCommand}"/></ContextMenu></TextBlock.ContextMenu>
          </TextBlock>
          <Button x:Name="Delete" Grid.Column="2" Command="{Binding DeleteCommand}" Opacity="0" Width="26" Height="28" Padding="6" VerticalAlignment="Top" Margin="0,3,0,0" ToolTip="删除任务" AutomationProperties.Name="{Binding DeleteLabel}">
            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="#8C9890" StrokeThickness="1.3"/>
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="TaskLabel" Property="TextDecorations" Value="Strikethrough"/><Setter TargetName="TaskLabel" Property="Foreground" Value="#8D9891"/></DataTrigger>
        <Trigger SourceName="TaskSurface" Property="IsMouseOver" Value="True"><Setter TargetName="TaskSurface" Property="Background" Value="#F1F5F0"/><Setter TargetName="Delete" Property="Opacity" Value="1"/></Trigger>
        <Trigger SourceName="TaskSurface" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Delete" Property="Opacity" Value="1"/></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Border Margin="12" Background="#FFFEFB" CornerRadius="20" BorderBrush="#E2E8E0" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#354A3D" BlurRadius="20" ShadowDepth="4" Opacity="0.16"/></Border.Effect>
    <Grid Margin="20,14,20,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="DragHeader" Background="Transparent" Cursor="SizeAll" ToolTip="按住这里拖动卡片">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Background="#E7EFE6" Width="26" Height="26" CornerRadius="8" Margin="0,0,9,0"><Path Data="M 6,13 L 10,17 L 20,8" Stroke="#3C7865" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
          <TextBlock Text="桌面待办" Foreground="#6F7D72" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Cursor="Arrow">
          <Button x:Name="MinimizeButton" Width="28" Height="28" Padding="8" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,6 L 12,6" Stroke="#7B887E" StrokeThickness="1.3"/></Button>
          <Button x:Name="CloseButton" Width="28" Height="28" Padding="8" ToolTip="关闭（任务自动保存）" AutomationProperties.Name="关闭"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="#7B887E" StrokeThickness="1.3"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="3,23,3,0">
        <StackPanel>
          <TextBlock Text="我的待办" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DateLabel}" Foreground="#8A958D" FontSize="11" Margin="0,7,0,0"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF3EB" CornerRadius="10" Padding="10,7"><TextBlock Text="{Binding RemainingLabel}" Foreground="#56755E" FontSize="11"/></Border>
      </Grid>
      <Grid Grid.Row="2" Margin="3,18,3,15">
        <ToggleButton x:Name="PinButton" Style="{StaticResource PinStyle}" HorizontalAlignment="Left" IsChecked="{Binding IsPinned, Mode=TwoWay}" ToolTip="{Binding PinHint}" AutomationProperties.Name="固定到桌面"/>
        <TextBlock Text="一件一件，慢慢完成" Foreground="#9BA397" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid x:Name="ListRegion" Grid.Row="3" ClipToBounds="True">
        <Border BorderBrush="#EAF0E6" BorderThickness="0,1,0,0"/>
        <ScrollViewer x:Name="TaskScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-3,12,-5,8" Padding="0,0,4,0" CanContentScroll="False">
          <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskTemplate}" IsEnabled="{Binding CanEditTasks}"/>
        </ScrollViewer>
        <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8" IsHitTestVisible="False">
          <Grid x:Name="EmptyArt" Width="72" Height="76" Margin="0,0,0,12">
            <Ellipse Fill="#F0F4EB" Width="68" Height="68"/>
            <Border Width="40" Height="48" CornerRadius="8" Background="#FFFEFB" BorderBrush="#BBCBB8" BorderThickness="1.2" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-8"/></Border.RenderTransform><StackPanel Margin="10,12,8,0"><Path Data="M 0,3 L 3,6 L 8,0" Stroke="#70966D" StrokeThickness="1.4"/><Border Background="#D2DFCB" Height="2" Margin="0,8,0,0"/><Border Background="#D2DFCB" Height="2" Margin="0,6,5,0"/></StackPanel></Border>
          </Grid>
          <TextBlock Text="给今天一个小小的开始" FontSize="14" HorizontalAlignment="Center" Foreground="#65765E"/>
          <TextBlock Text="在下方写下你的第一件待办" FontSize="11" HorizontalAlignment="Center" Foreground="#9CA594" Margin="0,9,0,0"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="4" Visibility="{Binding ToastVisibility}" Background="#EEF3EB" CornerRadius="8" Padding="10,5" Margin="0,0,0,8">
        <DockPanel><Button DockPanel.Dock="Right" Content="撤销" Command="{Binding UndoCommand}" Visibility="{Binding UndoVisibility}" Foreground="#3C7865" FontSize="11" Padding="5,3"/><TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/></DockPanel>
      </Border>
      <Border x:Name="InputBorder" Grid.Row="5" Background="#F4F6F0" BorderBrush="#E1E7DC" BorderThickness="1" CornerRadius="12" Padding="12,9,7,9">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding InputHint}" Foreground="#9BA595" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding PlaceholderVisibility}" Margin="2,0,0,0"/>
          <TextBox x:Name="TaskInput" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#354939" BorderThickness="0" VerticalContentAlignment="Center" Padding="1,4" MaxLength="2000" FontSize="13" AutomationProperties.Name="待办内容"/>
          <Button x:Name="AddButton" Grid.Column="1" Command="{Binding AddCommand}" Width="32" Height="32" Padding="0" ToolTip="{Binding AddHint}" AutomationProperties.Name="{Binding AddHint}">
            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="AddSurface" Background="#3C7865" CornerRadius="9"><TextBlock Text="{Binding AddGlyph}" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddSurface" Property="Background" Value="#2D6351"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AddSurface" Property="Background" Value="#214F40"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="AddSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="6" Margin="3,14,3,0">
        <Grid>
          <TextBlock Text="{Binding ProgressLabel}" Foreground="#7F8D7B" FontSize="10" VerticalAlignment="Center"/>
          <Button Content="清除已完成" Command="{Binding ClearCompletedCommand}" HorizontalAlignment="Right" Padding="0,2" FontSize="10" Foreground="#8A9685"/>
        </Grid>
        <ProgressBar Value="{Binding CompletedPercent, Mode=OneWay}" Maximum="100" Height="3" BorderThickness="0" Background="#EDF1E8" Foreground="#9EB796" Margin="0,8,0,0"/>
        <DockPanel Margin="0,9,0,0">
          <Button DockPanel.Dock="Right" Content="重新读取" Command="{Binding ReloadCommand}" FontSize="9" Padding="4,0" Margin="5,0,0,0" ToolTip="{Binding DataLocationHint}" AutomationProperties.Name="重新读取任务"/>
          <TextBlock Text="{Binding SaveStatus}" Foreground="{Binding SaveStatusColor}" FontSize="9" TextWrapping="Wrap" ToolTip="{Binding DataLocationHint}"/>
        </DockPanel>
      </StackPanel>
      <Thumb x:Name="ResizeHandle" Grid.RowSpan="7" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-8" Cursor="SizeNWSE" ToolTip="拖动调整卡片大小" AutomationProperties.Name="调整卡片大小">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M 4,12 L 12,4 M 8,12 L 12,8" Stroke="#B8C4B3" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
